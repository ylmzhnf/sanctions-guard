generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model Organization {
  id                  String           @id @default(cuid())
  name                String
  plan                Plan             @default(FREE)
  queriesUsed         Int              @default(0)
  queriesLimit        Int              @default(10)
  billingPeriodEnd    DateTime?
  createdAt           DateTime         @default(now())
  aiApiKey            String?
  aiProvider          AiProvider       @default(OPENAI)
  isLifetime          Boolean          @default(false)
  lemonCustomerId     String?          @unique
  lemonSubscriptionId String?          @unique
  aiThreshold         Int              @default(85)
  appSumoCode         AppSumoCode?
  auditLogs           AuditLog[]
  queries             ScreeningQuery[]
  users               User[]
}

model AppSumoCode {
  id     String        @id @default(cuid())
  code   String        @unique
  isUsed Boolean       @default(false)
  usedAt DateTime?
  orgId  String?       @unique
  org    Organization? @relation(fields: [orgId], references: [id])

  @@index([code])
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  username           String?
  role               Role             @default(USER)
  createdAt          DateTime         @default(now())
  name               String?
  orgId              String?
  updatedAt          DateTime         @default(now()) @updatedAt
  passwordHash       String
  mustChangePassword Boolean          @default(false)
  logs               AuditLog[]
  queries            ScreeningQuery[]
  organization       Organization?    @relation(fields: [orgId], references: [id])
}

model SanctionedEntity {
  id           String           @id @default(cuid())
  externalId   String           @unique
  aliases      String[]
  entityType   String
  listSource   ListSource
  reason       String?
  country      String?
  type         String?
  issueDate    DateTime?
  moreInfoUrl  String?
  createdAt    DateTime         @default(now())
  name         String
  isActive     Boolean          @default(true)
  lastSyncedAt DateTime         @default(now())
  programs     String[]
  matches      ScreeningMatch[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([listSource, isActive])
  @@index([isActive])
}

model ListSyncLog {
  id             String     @id @default(cuid())
  source         ListSource
  status         SyncStatus
  recordsAdded   Int        @default(0)
  recordsUpdated Int        @default(0)
  recordsRemoved Int        @default(0)
  error          String?
  syncedAt       DateTime   @default(now())
}

model ScreeningQuery {
  id            String           @id @default(cuid())
  fuzzyMatch    Boolean          @default(true)
  exactMatch    Boolean          @default(false)
  status        ScreeningStatus  @default(PENDING)
  matchedCount  Int              @default(0)
  riskLevel     RiskLevel?
  reportUrl     String?
  createdAt     DateTime         @default(now())
  userId        String
  orgId         String
  aiExplanation String?
  queryName     String
  auditLog      AuditLog?
  matches       ScreeningMatch[]
  org           Organization     @relation(fields: [orgId], references: [id])
  user          User             @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
}

model ScreeningMatch {
  id              String           @id @default(cuid())
  matchedEntityId String
  matchedName     String
  similarityScore Float
  matchedField    String
  listSource      ListSource
  queryId         String
  entity          SanctionedEntity @relation(fields: [matchedEntityId], references: [id])
  query           ScreeningQuery   @relation(fields: [queryId], references: [id])

  @@index([queryId])
  @@index([matchedEntityId])
}

model AuditLog {
  id            String          @id @default(cuid())
  userId        String?
  action        String
  createdAt     DateTime        @default(now())
  integrityHash String
  metadata      Json
  orgId         String
  queryId       String?         @unique
  org           Organization    @relation(fields: [orgId], references: [id])
  query         ScreeningQuery? @relation(fields: [queryId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum RiskLevel {
  CLEAR
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ListSource {
  OFAC
  EU
  UN
  UK_HMT
  OTHER
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}
