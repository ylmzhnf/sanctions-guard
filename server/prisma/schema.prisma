generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}


// GLOBAL SYSTEM SETTINGS (Admin-configurable)
model SystemSetting {
  key       String   @id   // e.g. "smtp_host", "default_ai_provider"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ENUMS

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum RiskLevel {
  CLEAR
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ListSource {
  OFAC
  EU
  UN
  UK_HMT
  CUSTOM
  OTHER
}

enum RequestSource {
  WEB_APP
  API
  BULK_UPLOAD
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}

// ORGANIZATION & AUTHENTICATION

model Organization {
  id        String   @id @default(cuid())
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  settings  OrganizationSettings?
  users     User[]
  queries   ScreeningQuery[]
  auditLogs AuditLog[]
}

model OrganizationSettings {
  id                String       @id @default(cuid())
  orgId             String       @unique
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Bring Your Own Key (BYOK)
  aiProvider        AiProvider   @default(OPENAI)
  aiApiKey          String?
  aiThreshold       Int          @default(50)
  osintApiKey       String?
  activeListSources ListSource[]
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String?
  name               String?
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  role               Role     @default(USER)
  isActive           Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orgId              String?
  organization       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  queries            ScreeningQuery[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([email])
  @@index([orgId])
}

// SANCTIONS DATA ENGINE

model SanctionedEntity {
  id           String     @id @default(cuid())
  externalId   String     @unique
  name         String
  aliases      String[]
  entityType   String
  listSource   ListSource
  reason       String?    @db.Text
  country      String?
  programs     String[]
  issueDate    DateTime?
  moreInfoUrl  String?

  isActive     Boolean    @default(true)
  lastSyncedAt DateTime   @default(now())
  createdAt    DateTime   @default(now())

  matches      ScreeningMatch[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([listSource, isActive])
  @@index([isActive])
}

model ListSyncLog {
  id             String     @id @default(cuid())
  source         ListSource
  status         SyncStatus
  recordsAdded   Int        @default(0)
  recordsUpdated Int        @default(0)
  recordsRemoved Int        @default(0)
  error          String?    @db.Text
  syncedAt       DateTime   @default(now())
}

// ─── SCREENING RESULTS & AUDIT

model ScreeningQuery {
  id            String          @id @default(cuid())
  queryName     String
  status        ScreeningStatus @default(PENDING)
  riskLevel     RiskLevel?
  matchCount    Int             @default(0)

  fuzzyMatch    Boolean         @default(true)
  exactMatch    Boolean         @default(false)

  aiExplanation String?         @db.Text
  osintResults  Json?
  reportUrl     String?
  source        RequestSource   @default(WEB_APP)

  createdAt     DateTime        @default(now())

  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  matches       ScreeningMatch[]
  auditLog      AuditLog?

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
}

model ScreeningMatch {
  id              String           @id @default(cuid())
  matchedEntityId String
  matchedName     String
  similarityScore Float
  matchedField    String
  listSource      ListSource

  entity          SanctionedEntity @relation(fields: [matchedEntityId], references: [id])
  queryId         String
  query           ScreeningQuery   @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([matchedEntityId])
}

model AuditLog {
  id            String          @id @default(cuid())
  action        String
  actorId       String
  metadata      Json
  integrityHash String

  createdAt     DateTime        @default(now())

  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  queryId       String?         @unique
  query         ScreeningQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
}

// NOTIFICATIONS SYSTEM

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}