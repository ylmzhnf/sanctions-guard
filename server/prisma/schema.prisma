generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}


enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
  SELF_HOSTED  
}

enum Role {
  USER         
  ADMIN        
  SUPER_ADMIN  
  API_SERVICE  
}

enum RiskLevel {
  CLEAR
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScreeningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ListSource {
  OFAC
  EU
  UN
  UK_HMT
  OTHER
}

enum RequestSource {
  WEB_APP      
  API          
  BULK_UPLOAD  
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}


model Organization {
  id                   String    @id @default(cuid())
  name                 String

  
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  billingPeriodEnd     DateTime?
  queriesUsed          Int       @default(0)
  queriesLimit         Int       @default(10)
  isUnlimited          Boolean   @default(false)
  
  createdAt            DateTime  @default(now())

  settings             OrganizationSettings?
  users                User[]
  queries              ScreeningQuery[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]  
  webhooks             Webhook[] 
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  orgId              String       @unique
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  aiProvider         AiProvider   @default(OPENAI)
  aiApiKey           String?      
  aiThreshold        Int          @default(85) 
  activeListSources  ListSource[] 
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  username           String?
  name               String?
  passwordHash       String
  mustChangePassword Boolean      @default(false)
  role               Role         @default(USER)
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  orgId              String?
  organization       Organization? @relation(fields: [orgId], references: [id])
  
  queries            ScreeningQuery[]
  auditLogs          AuditLog[]
}


model ApiKey {
  id           String       @id @default(cuid())
  keyHash      String       @unique  
  name         String      
  lastUsedAt   DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Webhook {
  id           String       @id @default(cuid())
  url          String       
  secret       String       
  events       String[]     
  isActive     Boolean      @default(true)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}


model SanctionedEntity {
  id           String       @id @default(cuid())
  externalId   String       @unique 
  name         String
  aliases      String[]
  entityType   String       
  listSource   ListSource
  reason       String?      
  country      String?
  issueDate    DateTime?
  programs     String[]     
  moreInfoUrl  String?
  
  isActive     Boolean      @default(true)
  lastSyncedAt DateTime     @default(now())
  createdAt    DateTime     @default(now())

  matches      ScreeningMatch[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([listSource, isActive])
}

model ListSyncLog {
  id             String     @id @default(cuid())
  source         ListSource
  status         SyncStatus
  recordsAdded   Int        @default(0)
  recordsUpdated Int        @default(0)
  recordsRemoved Int        @default(0)
  error          String?
  syncedAt       DateTime   @default(now())
}


model ScreeningQuery {
  id            String          @id @default(cuid())
  queryName     String          
  status        ScreeningStatus @default(PENDING)
  riskLevel     RiskLevel?
  matchCount    Int             @default(0)
  
  fuzzyMatch    Boolean         @default(true)
  exactMatch    Boolean         @default(false)
  
  aiExplanation String?         
  osintResults  Json?           
  reportUrl     String?         
  source        RequestSource   @default(WEB_APP) 
  
  createdAt     DateTime        @default(now())

  userId        String?         
  user          User?           @relation(fields: [userId], references: [id])
  
  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id])

  matches       ScreeningMatch[]
  auditLog      AuditLog?

  @@index([orgId, createdAt])
}

model ScreeningMatch {
  id              String           @id @default(cuid())
  matchedEntityId String
  matchedName     String
  similarityScore Float            
  matchedField    String           
  listSource      ListSource

  entity          SanctionedEntity @relation(fields: [matchedEntityId], references: [id])
  queryId         String
  query           ScreeningQuery   @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([matchedEntityId])
}


model AuditLog {
  id            String          @id @default(cuid())
  action        String          
  actorId       String          
  metadata      Json            
  integrityHash String          
  
  createdAt     DateTime        @default(now())

  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id])
  
  userId        String?         
  user          User?           @relation(fields: [userId], references: [id])

  queryId       String?         @unique
  query         ScreeningQuery? @relation(fields: [queryId], references: [id])

  @@index([orgId, createdAt])
  @@index([actorId])
}